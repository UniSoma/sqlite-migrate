{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]}

  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  ;; ADR 0010: CI version-matrix floor — oldest sqlite-jdbc conveniently
  ;; pinnable; 3.40.1.0 is where upstream native-image testing begins (ADR 0014).
  :sqlite-floor
  {:override-deps {org.xerial/sqlite-jdbc {:mvn/version "3.40.1.0"}}}

  ;; Native-image smoke program (ci/smoke/smoke.clj); "classes" holds its AOT output.
  :smoke
  {:extra-paths ["ci/smoke" "classes"]}

  ;; Release tasks (ADR 0014): clojure -T:build jar|install|deploy, via bb.
  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
          slipset/deps-deploy {:mvn/version "0.2.2"}}
   :ns-default build}

  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}}}
